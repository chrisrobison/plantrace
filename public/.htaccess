# Apache config for serving PlanTrace with DocumentRoot pointed at this
# directory (see README.md "Deploying to Apache"). Not needed for
# `php -S ... public/router.php` — that path uses router.php instead.
#
# PlanTrace has no client-side routes of its own (workflow steps are
# in-memory state, not URLs), so there is very little to do here: real
# static files are served as-is by Apache, and the only thing worth routing
# is the /api/ shell.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /api/... that isn't a real file -> the API front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/ api/index.php [L]

  # Anything else that isn't a real file/directory falls back to the app
  # shell, mirroring router.php's behavior for the built-in server.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# Raise upload limits to match UploadStore::MAX_BYTES (src/Http/UploadStore.php).
# mod_php only — for PHP-FPM, either edit the pool's php_admin_value settings
# or rely on public/.user.ini (FPM reads .user.ini; mod_php does not).
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
</IfModule>

# Uploaded source sheets are stored under storage/ (a sibling of public/,
# outside the web root — see src/Http/UploadStore.php) and are only ever
# served back through the validated public/api/uploads.php endpoint, never
# as a direct static path.
