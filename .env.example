# Copy this file to `.env` (same directory) and fill in values only if you
# need them — every setting below is optional, and PlanTrace works with no
# .env at all when it's mounted at a site's root and checked out somewhere
# normal. Values already set as real environment variables (e.g. by your
# hosting panel) always take priority over this file.

# The URL path this app is mounted under, with a leading slash and no
# trailing slash. Leave blank when served from the domain/vhost root
# (e.g. https://example.com/). Set this when it's served from a
# subdirectory of an existing site instead, e.g. an Apache Alias:
#
#   Alias /plantrace /path/to/plantrace/public
#   <Directory /path/to/plantrace/public>
#       AllowOverride All
#       Require all granted
#   </Directory>
#
# -> https://example.com/plantrace/ needs APP_BASE_PATH=/plantrace
APP_BASE_PATH=

# Absolute filesystem path to this project's root directory (the parent of
# public/ and src/). Leave blank to auto-detect from the running script's
# own location, which is correct for a normal checkout. Set this explicitly
# if your hosting setup serves public/ from somewhere that doesn't reflect
# where the rest of the project (src/, docs/) actually lives on disk — e.g.
# public/ reached via a symlink into a shared docroot.
APP_ROOT_PATH=
